        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Bike_Barna</IRI>
        <Literal xml:lang="en">Bike_Barna</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Bilbao</IRI>
        <Literal xml:lang="en">Bilbao (Basque: Bilbo) is a municipality located in northern Spain and a town within the municipality, capital of the province and historical territory of Biscay, in the autonomous community of the Basque Country. Bilbao is the capital and only locality in the municipality, and with a population of 348,089 (INE 2024), it is the most populated city in the autonomous community, being the head of the Bilbao metropolitan area, a conurbation of more than 1,000,000 inhabitants that extends along the Bilbao estuary or Nervión.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
