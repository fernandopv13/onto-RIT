        <IRI>#Carnaval_Barcelona</IRI>
        <Literal xml:lang="en">During this week, the city is filled with color, music, and celebration with activities in various districts, including streets and parades.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
