    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/abstract"/>
        <Literal xml:lang="en">The domain of the ontology is framed around tourism recommendations and their  main characteristics. The scope of the ontology will be modeled on the places to visit, what to do there, accomodations and where to eat in different cities.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/author"/>
        <Literal>Fernando Pay Vázquez</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <Literal xml:lang="en">An ontology devoted to make smart tourism recommendations</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/title"/>
        <Literal xml:lang="en">Smart Tourism Recommendations</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">The ontology includes the data from the provided files.

And some links to different pages of:

https://dbpedia.org/</Literal>
    </Annotation>
