        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Toledo_Coords</IRI>
        <Literal xml:lang="en">Toledo_Coords</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TourismEntity</IRI>
        <Literal xml:lang="en">Tourism is a term that includes the activities that people carry out during their trips and stays in places other than their usual environment for a period of time less than a year, for purposes, above all, of leisure, or other purposes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#TourismEntity</IRI>
        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Tourism</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
