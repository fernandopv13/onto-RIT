    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Restaurant_Sabor_Valencia</IRI>
        <Literal xml:lang="en">Excellent Andalusian and Mediterranean cuisine, without forgetting that we&apos;re in Valencia and its signature dish: paella.</Literal>
    </AnnotationAssertion>
