        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Valencia</IRI>
        <Literal xml:lang="en">Valencia (officially in Valencian: València) is a municipality and city in Spain, capital of the province of the same name and of the Valencian Community. Its population is 825,948 inhabitants (INE 2024), reaching 1,615,223 inhabitants (in 2023) if its urban area is included. It is the third most populated city and metropolitan area in Spain, behind Madrid and Barcelona.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Valencia</IRI>
        <Literal xml:lang="en">Valencia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Valencia_Coords</IRI>
