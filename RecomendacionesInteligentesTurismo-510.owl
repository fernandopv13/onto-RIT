    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Restaurants</IRI>
        <Literal xml:lang="en">A restaurant is a service establishment, usually a public one, where food and drinks are paid for and consumed on the premises or taken away. Today, there is a wide variety of service options and cuisines.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
