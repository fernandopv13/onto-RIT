        <IRI>#Tourist</IRI>
        <Literal xml:lang="en">Tourist_Cathegory(1-star)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Touristic</IRI>
        <Literal xml:lang="en">A &quot;resort hotel&quot; (or tourist hotel) is an accommodation establishment specifically designed and operated to accommodate travelers and tourists. It differs from a residential hotel in that its primary purpose is to serve visitors who do not reside in the area.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Touristic</IRI>
        <Literal xml:lang="en">Touristic</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Tramway</IRI>
        <Literal xml:lang="en">A tramway, also known as a metrotram, is a rail transport system in which vehicles, whether individual railcars or self-propelled trains coupled by multiple units, move on rails and on the surface in urban areas, such as on the streets themselves, often without separation from other traffic, without a track or path or designated section. In some cases, the tramway track may run on dedicated tracks.
Trams are generally lighter and have shorter routes than other rail systems such as commuter rail or metro rail. Today, most trams use electric power, usually supplied by a pantograph running on an overhead line; older systems used a pole trolley to transfer electricity to the unit.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Tramway</IRI>
        <Literal xml:lang="en">Tramway</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
